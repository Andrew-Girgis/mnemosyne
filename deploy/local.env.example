# Copy to deploy/local.env (git-ignored) and adjust. Non-secret settings only;
# secrets go in s or your environment, never in this file.

# Where browsers reach Wakapi, e.g. your `tailscale serve` HTTPS address.
WAKAPI_PUBLIC_URL=http://127.0.0.1:3100

# Build Wakapi from a local checkout instead of GitHub (path relative to this repo).
# WAKAPI_BUILD_CONTEXT=../wakapi
